DATABASE_URL="postgresql://idol_user:replace-password@your-rds-host:5432/idol_db_staging?schema=public"

PORT=3000
NODE_ENV=production
JWT_SECRET="replace-with-a-staging-jwt-secret"
JWT_REFRESH_SECRET="replace-with-a-staging-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
DOWNLOAD_SIGN_SECRET="replace-with-staging-download-sign-secret"

CORS_ORIGINS="https://staging.enjoycorner.com,http://localhost:3001"
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_IP_ATTEMPTS=30
LOGIN_LOCK_WINDOW_SECONDS=600
LOGIN_LOCK_MAX_FAILURES_IP=8
LOGIN_LOCK_MAX_FAILURES_USERNAME=5
LOGIN_LOCK_DURATION_SECONDS=900

REDIS_HOST="fans-redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=1
REDIS_KEY_PREFIX="staging:"
BULLMQ_PREFIX="staging"

ENABLE_VIDEO_FEATURE=false
ENABLE_MEDIA_CLEANUP_SCHEDULER=false
TRUST_PROXY=true
BODY_PARSER_DEBUG=false
ENABLE_SWAGGER=false

USE_OSS_STORAGE=true
LOCAL_UPLOAD_DIR="./uploads"
UPLOAD_DIR="./uploads"

OSS_ACCESS_KEY_ID="your-staging-oss-access-key-id"
OSS_ACCESS_KEY_SECRET="your-staging-oss-access-key-secret"
OSS_BUCKET="your-BUCKET-name"
OSS_REGION="oss-cn-beijing"
OSS_ENDPOINT="oss-cn-beijing.aliyuncs.com"
OSS_CDN_BASE_URL=""
OSS_OBJECT_PREFIX="staging"
